# Paste into your Dokploy Compose app's Environment settings.
# Replace the example credentials and public URL before deploying.

POCKETBASE_ADMIN_EMAIL=you@example.com
POCKETBASE_ADMIN_PASSWORD=replace-with-a-strong-unique-password
KAINBU_ADMIN_EMAILS=you@example.com
KAINBU_PUBLIC_URL=https://kainbu.example.com

# Optional: enables AI features.
OPENROUTER_API_KEY=

# Internal database address. Leave VITE_POCKETBASE_URL unset.
POCKETBASE_URL=http://pocketbase:8090
